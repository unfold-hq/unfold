{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/unfold-hook.mjs\" --vscode",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/unfold-hook.mjs\" --vscode",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/unfold-hook.mjs\" --vscode",
        "timeout": 20
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/unfold-hook.mjs\" --vscode",
        "timeout": 20
      }
    ]
  }
}
